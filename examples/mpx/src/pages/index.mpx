<template>
  <view class="page-shell">
    <view class="eyebrow">MPX</view>
    <view class="title">SQLite 跨端 demo</view>
    <view class="status">状态：{{status}}</view>
    <view class="result">{{result}}</view>
    <button id="run-sqlite" bindtap="runDemo">运行 SQLite</button>
  </view>
</template>

<script>
import { createStringStorage, runSqliteDemo } from '@weapp-sqlite/demo-shared'

const host = globalThis

function createMpxStorage() {
  return createStringStorage({
    load: name => new Promise((resolve) => {
      host.wx?.getStorage({ key: name, success: ({ data }) => resolve(data), fail: () => resolve(undefined) })
    }),
    save: (name, value) => new Promise((resolve, reject) => {
      host.wx?.setStorage({ key: name, data: value, success: resolve, fail: reject })
    }),
  })
}

export default {
  data: {
    status: 'ready',
    result: '点击按钮运行 SQLite migration + transaction',
  },
  methods: {
    async runDemo() {
      this.status = 'running'
      try {
        const demo = await runSqliteDemo({ storage: createMpxStorage(), locateFile: file => `/assets/${file}` })
        this.status = 'ready'
        this.result = JSON.stringify(demo.rows)
      }
      catch (error) {
        this.status = 'error'
        this.result = error instanceof Error ? error.message : String(error)
      }
    },
  },
}
</script>

<style lang="scss">
.page-shell {
  min-height: 100vh;
  padding: 48rpx;
  color: #102a43;
  background: #f4f7f9;
}

.eyebrow,
.title,
.status,
.result {
  display: block;
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #168f7a;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
}

.status,
.result {
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
}
</style>
