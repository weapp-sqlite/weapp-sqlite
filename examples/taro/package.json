{
  "name": "weapp-sqlite-demo-taro",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Taro SQLite demo",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "test": "vitest run test/index.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@weapp-sqlite/demo-shared": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "7.27.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "babel-preset-taro": "4.2.1"
  }
}
