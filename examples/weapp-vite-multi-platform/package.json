{
  "name": "weapp-sqlite-demo-weapp-vite",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "weapp-vite multiPlatform SQLite demo",
  "scripts": {
    "dev": "wv dev -p weapp",
    "dev:web": "wv dev -p web --host",
    "build": "pnpm build:weapp",
    "build:weapp": "tsx scripts/build-platform.ts weapp",
    "build:alipay": "tsx scripts/build-platform.ts alipay",
    "build:tt": "tsx scripts/build-platform.ts tt",
    "build:swan": "tsx scripts/build-platform.ts swan",
    "build:jd": "tsx scripts/build-platform.ts jd",
    "build:xhs": "tsx scripts/build-platform.ts xhs",
    "build:web": "tsx scripts/build-platform.ts web",
    "test": "vitest run test/index.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "wv prepare"
  },
  "dependencies": {
    "@weapp-sqlite/debug": "workspace:*",
    "@weapp-sqlite/demo-shared": "workspace:*",
    "@weapp-sqlite/weapp-vite": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "weapp-vite": "^6.25.1"
  }
}
