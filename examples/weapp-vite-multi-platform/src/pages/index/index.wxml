<view class="page-shell">
  <view class="header">
    <view class="eyebrow">weapp-vite SQLite acceptance</view>
    <view class="title">运行时验收</view>
    <view class="platform">目标平台：{{platform}}</view>
  </view>

  <view class="status-panel">
    <view class="status-row">
      <text>状态</text>
      <text id="acceptance-status" class="status-value status-{{acceptance.phase}}">{{acceptance.phase}}</text>
    </view>
    <view wx:if="{{acceptance.environment}}" id="acceptance-environment" class="environment">
      {{acceptance.environment.system || acceptance.environment.userAgent || acceptance.environment.target}}
    </view>
    <view wx:if="{{acceptance.error}}" id="acceptance-error" class="error">
      {{acceptance.error.code}}：{{acceptance.error.message}}
    </view>
  </view>

  <view id="acceptance-checks" class="checks">
    <view wx:for="{{acceptance.checks}}" wx:key="id" class="check-row">
      <text class="check-state">{{item.passed ? 'PASS' : 'FAIL'}}</text>
      <view class="check-copy">
        <text class="check-id">{{item.id}}</text>
        <text class="check-detail">{{item.detail}}</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <button id="reset-acceptance" bind:tap="resetAcceptance">重置数据库</button>
    <button id="run-acceptance" type="primary" bind:tap="runAcceptance">首次验收</button>
    <button id="verify-acceptance" bind:tap="verifyAcceptance">验证持久化</button>
    <button id="copy-report" bind:tap="copyReport" disabled="{{!report}}">复制报告</button>
  </view>

  <text id="acceptance-report" class="report" selectable="true">{{report}}</text>

  <!-- weapp-sqlite-debug:start -->
  <view wx:if="{{debugEnabled}}" id="sqlite-debug-panel" class="debug-panel">
    <view class="debug-heading">
      <text class="eyebrow">开发调试</text>
      <text class="debug-title">SQLite 数据面板</text>
    </view>
    <view id="debug-overview" class="debug-overview">
      <text>平台：{{platform}}</text>
      <text>数据库：{{debug.snapshot.databaseName || '未导出'}}</text>
      <text>大小：{{debug.snapshot.byteLength || 0}} bytes</text>
      <text>迁移：{{debug.snapshot.migrationVersions || []}}</text>
      <text>快照时间：{{debug.snapshot.exportedAt || '未生成'}}</text>
      <text>系统：{{debug.snapshot.runtime.system || debug.snapshot.runtime.userAgent || '未知'}}</text>
    </view>
    <view class="debug-actions">
      <button id="debug-refresh" bind:tap="refreshDebug">刷新</button>
      <button id="debug-export" bind:tap="exportDebug">导出 SQLite</button>
      <button id="debug-reset" bind:tap="resetDebug">重置数据库</button>
      <input wx:if="{{platform === 'web'}}" id="debug-import" type="file" bindchange="importDebug" />
    </view>
    <view id="debug-tables" class="debug-tables">
      <text class="debug-label">表</text>
      <view wx:for="{{debug.tables}}" wx:key="name" data-table="{{item.name}}" bind:tap="selectDebugTable" class="debug-table-item {{item.name === debug.selectedTable ? 'selected' : ''}}">
        {{item.name}}
      </view>
    </view>
    <view id="debug-schema" class="debug-schema">
      <text class="debug-label">结构：{{debug.selectedTable || '未选择'}}</text>
      <view wx:for="{{debug.columns}}" wx:key="name" class="debug-column">
        <text>{{item.name}}</text><text>{{item.type}}</text><text>{{item.primaryKey ? 'PK' : ''}}</text><text>{{item.notNull ? 'NOT NULL' : ''}}</text>
      </view>
    </view>
    <view id="debug-data" class="debug-data">
      <view class="debug-pagination">
        <text class="debug-label">数据（{{debug.pageLabel}}）</text>
        <view class="debug-page-actions">
          <button id="debug-page-previous" bind:tap="previousDebugPage" disabled="{{!debug.page || debug.page.offset <= 0}}">上一页</button>
          <button id="debug-page-next" bind:tap="nextDebugPage" disabled="{{!debug.page || debug.page.offset + debug.page.limit >= debug.page.total}}">下一页</button>
        </view>
      </view>
      <view wx:for="{{debug.displayRows}}" wx:key="index" class="debug-row">
        <text selectable="true">{{item}}</text>
      </view>
    </view>
    <view id="debug-sql" class="debug-sql">
      <textarea id="debug-sql-editor" value="{{debug.sql}}" bindinput="onDebugSqlInput" auto-height="true" maxlength="10000" />
      <view class="debug-actions">
        <button id="debug-query" bind:tap="runDebugQuery">查询 SQL</button>
        <button id="debug-write" type="warn" bind:tap="runDebugWrite">确认写入</button>
      </view>
      <text id="debug-result" class="report" selectable="true">{{debug.result}}</text>
      <view wx:if="{{debug.error}}" id="debug-error" class="error">{{debug.error.code}}：{{debug.error.message}}</view>
    </view>
  </view>
  <!-- weapp-sqlite-debug:end -->
</view>
