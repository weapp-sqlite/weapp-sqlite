{
  "name": "weapp-sqlite",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "面向小程序与 Web 宿主的可插拔 SQLite driver workspace",
  "author": "weapp-sqlite contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-sqlite/weapp-sqlite.git"
  },
  "bugs": {
    "url": "https://github.com/weapp-sqlite/weapp-sqlite/issues"
  },
  "keywords": ["sqlite", "wasm", "weapp", "miniprogram", "driver"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "vitest run",
    "test:dev": "vitest",
    "lint": "turbo run lint",
    "tsd": "turbo run tsd",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.acceptance.json",
    "format": "eslint . --fix",
    "validate": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run tsd && pnpm run test",
    "acceptance:build": "tsx scripts/acceptance-build.ts",
    "acceptance:web": "playwright test --config e2e/playwright.config.ts",
    "acceptance:debug:web": "pnpm --filter @weapp-sqlite/weapp-vite build && cross-env WEAPP_SQLITE_DEBUG=1 pnpm --filter weapp-sqlite-demo-weapp-vite build:web && playwright test --config e2e/playwright.debug.config.ts",
    "acceptance:devtools:doctor": "pnpm --filter weapp-sqlite-demo-weapp-vite exec wv ide doctor dist/weapp --strict --json",
    "acceptance:devtools": "vitest run --config ./e2e/vitest.e2e.devtools.config.ts e2e/ide/sqlite.acceptance.test.ts",
    "acceptance:debug:devtools": "pnpm --filter @weapp-sqlite/weapp-vite build && cross-env WEAPP_SQLITE_DEBUG=1 pnpm --filter weapp-sqlite-demo-weapp-vite build:weapp && vitest run --config ./e2e/vitest.e2e.devtools.config.ts e2e/ide/sqlite.debug.test.ts",
    "acceptance:headless": "cross-env WEAPP_VITE_E2E_RUNTIME_PROVIDER=headless vitest run --config ./e2e/vitest.e2e.devtools.config.ts e2e/ide/sqlite.acceptance.test.ts",
    "acceptance:mobile:prepare": "tsx scripts/acceptance-mobile-prepare.ts",
    "acceptance:verify": "tsx scripts/acceptance-verify.ts",
    "release": "pnpm change",
    "version-packages": "pnpm version -r",
    "publish-packages": "repo release stable publish",
    "release:pre": "repo release pre publish",
    "------": "--------------",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "commit",
    "commitlint": "commitlint --edit",
    "-------": "---------------",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "------simple": "--------------",
    "pr:alpha": "repo release pre enter alpha",
    "pr:beta": "repo release pre enter beta",
    "pr:rc": "repo release pre enter rc",
    "pr:next": "repo release pre enter next",
    "pr:exit": "repo release pre exit",
    "--------": "----------------"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "~4.1.10",
    "@weapp-vite/miniprogram-automator": "^1.2.16",
    "ci-info": "^4.4.0",
    "cross-env": "^10.1.0",
    "defu": "^6.1.7",
    "es-toolkit": "^1.52.0",
    "eslint": "^10.9.1",
    "execa": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "only-allow": "^1.2.2",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "repoctl": "^5.4.4",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "tsd": "^0.33.0",
    "tsdown": "0.22.14",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "vitest": "~4.1.10",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
