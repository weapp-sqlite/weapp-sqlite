{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "env": ["REPO_DOCS_CHANNEL", "REPO_DOCS_URL"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", ".source/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$"],
      "env": ["REPO_DOCS_CHANNEL", "REPO_DOCS_URL"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    }
  }
}
