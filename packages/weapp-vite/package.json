{
  "name": "@weapp-sqlite/weapp-vite",
  "type": "module",
  "version": "0.3.1",
  "description": "weapp-vite 全端统一 SQLite runtime 与构建插件",
  "author": "weapp-sqlite contributors",
  "license": "MIT",
  "homepage": "https://github.com/weapp-sqlite/weapp-sqlite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-sqlite/weapp-sqlite.git",
    "directory": "packages/weapp-vite"
  },
  "bugs": {
    "url": "https://github.com/weapp-sqlite/weapp-sqlite/issues"
  },
  "keywords": [
    "sqlite",
    "weapp-vite",
    "miniprogram",
    "web",
    "wasm"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "node": null,
        "default": "./dist/runtime.mjs"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "node": null,
        "default": "./dist/runtime.cjs"
      }
    },
    "./debug": {
      "import": {
        "types": "./dist/debug.d.mts",
        "node": null,
        "default": "./dist/debug.mjs"
      },
      "require": {
        "types": "./dist/debug.d.cts",
        "node": null,
        "default": "./dist/debug.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.mts",
        "default": "./dist/adapter.mjs"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.mts",
        "default": "./dist/advanced.mjs"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    },
    "./workspace": {
      "import": {
        "types": "./dist/workspace.d.mts",
        "node": null,
        "default": "./dist/workspace.mjs"
      },
      "require": {
        "types": "./dist/workspace.d.cts",
        "node": null,
        "default": "./dist/workspace.cjs"
      }
    },
    "./devtools-runtime": {
      "import": {
        "types": "./dist/devtools-runtime.d.mts",
        "node": null,
        "default": "./dist/devtools-runtime.mjs"
      },
      "require": {
        "types": "./dist/devtools-runtime.d.cts",
        "node": null,
        "default": "./dist/devtools-runtime.cjs"
      }
    }
  },
  "main": "./dist/plugin.cjs",
  "module": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "tsd": "pnpm build && tsd --typings dist/plugin.d.mts --files test-d/**/*.test-d.ts"
  },
  "peerDependencies": {
    "@weapp-sqlite/devtools": "workspace:*",
    "weapp-vite": ">=6.22.0"
  },
  "peerDependenciesMeta": {
    "@weapp-sqlite/devtools": {
      "optional": true
    }
  },
  "dependencies": {
    "@weapp-sqlite/core": "workspace:*",
    "@weapp-sqlite/debug": "workspace:*",
    "@weapp-sqlite/miniprogram": "workspace:*",
    "@weapp-sqlite/sqljs": "workspace:*",
    "@weapp-sqlite/wasm": "workspace:*",
    "@weapp-sqlite/web": "workspace:*",
    "vite": "8.3.2"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "@weapp-sqlite/devtools": "workspace:*",
    "weapp-vite": "^7.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "paths": {}
    }
  }
}
