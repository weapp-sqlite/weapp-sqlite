{
  "name": "weapp-sqlite",
  "type": "module",
  "version": "0.2.1",
  "description": "weapp-sqlite 的统一门面包",
  "author": "weapp-sqlite contributors",
  "license": "MIT",
  "homepage": "https://github.com/weapp-sqlite/weapp-sqlite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-sqlite/weapp-sqlite.git",
    "directory": "packages/weapp-sqlite"
  },
  "bugs": {
    "url": "https://github.com/weapp-sqlite/weapp-sqlite/issues"
  },
  "keywords": [
    "sqlite",
    "weapp",
    "miniprogram",
    "wasm"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "node": null,
        "default": "./dist/runtime.mjs"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "node": null,
        "default": "./dist/runtime.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.mts",
        "default": "./dist/adapter.mjs"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./debug": {
      "import": {
        "types": "./dist/debug.d.mts",
        "node": null,
        "default": "./dist/debug.mjs"
      },
      "require": {
        "types": "./dist/debug.d.cts",
        "node": null,
        "default": "./dist/debug.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.mts",
        "default": "./dist/advanced.mjs"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    },
    "./workspace": {
      "import": {
        "types": "./dist/workspace.d.mts",
        "node": null,
        "default": "./dist/workspace.mjs"
      },
      "require": {
        "types": "./dist/workspace.d.cts",
        "node": null,
        "default": "./dist/workspace.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "test": "vitest run",
    "release": "pnpm publish",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "tsd": "pnpm build && tsd --typings dist/index.d.mts --files test-d/**/*.test-d.ts"
  },
  "tsd": {
    "compilerOptions": {
      "baseUrl": ".",
      "lib": [
        "ESNext",
        "DOM",
        "DOM.Iterable"
      ],
      "module": "NodeNext",
      "moduleResolution": "Bundler",
      "paths": {
        "@weapp-sqlite/core": [
          "../core/dist/index.d.mts"
        ],
        "@weapp-sqlite/weapp-vite": [
          "../weapp-vite/dist/plugin.d.mts"
        ],
        "@weapp-sqlite/weapp-vite/adapter": [
          "../weapp-vite/dist/adapter.d.mts"
        ],
        "@weapp-sqlite/weapp-vite/advanced": [
          "../weapp-vite/dist/advanced.d.mts"
        ],
        "@weapp-sqlite/weapp-vite/debug": [
          "../weapp-vite/dist/debug.d.mts"
        ],
        "@weapp-sqlite/weapp-vite/runtime": [
          "../weapp-vite/dist/runtime.d.mts"
        ],
        "@weapp-sqlite/weapp-vite/workspace": [
          "../weapp-vite/dist/workspace.d.mts"
        ]
      },
      "skipLibCheck": true
    }
  },
  "dependencies": {
    "@weapp-sqlite/weapp-vite": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
