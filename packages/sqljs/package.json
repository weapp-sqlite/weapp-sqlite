{
  "name": "@weapp-sqlite/sqljs",
  "type": "module",
  "version": "0.3.0",
  "description": "weapp-sqlite 的 full 与 lite sql.js WASM 引擎资源",
  "author": "weapp-sqlite contributors",
  "license": "MIT",
  "homepage": "https://github.com/weapp-sqlite/weapp-sqlite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-sqlite/weapp-sqlite.git",
    "directory": "packages/sqljs"
  },
  "bugs": {
    "url": "https://github.com/weapp-sqlite/weapp-sqlite/issues"
  },
  "keywords": [
    "sqlite",
    "sql.js",
    "wasm",
    "weapp",
    "miniprogram"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/full.d.mts",
      "browser": {
        "import": "./dist/full-browser.mjs",
        "require": "./dist/full-browser.cjs"
      },
      "import": "./dist/full.mjs",
      "require": "./dist/full.cjs"
    },
    "./full": {
      "types": "./dist/full.d.mts",
      "browser": {
        "import": "./dist/full-browser.mjs",
        "require": "./dist/full-browser.cjs"
      },
      "import": "./dist/full.mjs",
      "require": "./dist/full.cjs"
    },
    "./lite": {
      "types": "./dist/lite.d.mts",
      "import": "./dist/lite.mjs",
      "require": "./dist/lite.cjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs"
    }
  },
  "main": "./dist/full.cjs",
  "module": "./dist/full.mjs",
  "types": "./dist/full.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "verify:lite": "node ./scripts/verify-lite.mjs",
    "rebuild:lite": "./scripts/rebuild-lite.sh",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "tsd": "pnpm build && tsd --typings dist/full.d.mts --files test-d/**/*.test-d.ts",
    "verify:engines": "node ./scripts/verify-lite.mjs",
    "rebuild:engines": "bash ./scripts/rebuild-engines.sh"
  },
  "dependencies": {
    "@weapp-sqlite/wasm": "workspace:*"
  },
  "devDependencies": {
    "@weapp-sqlite/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
