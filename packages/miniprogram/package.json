{
  "name": "@weapp-sqlite/miniprogram",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "小程序 SQLite WASM 宿主协议与持久化 adapter",
  "license": "MIT",
  "keywords": ["sqlite", "wasm", "miniprogram", "weapp-sqlite"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist"],
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "tsd": "pnpm build && tsd --files test-d/**/*.test-d.ts"
  },
  "dependencies": {
    "@weapp-sqlite/wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.2"
  },
  "publishConfig": {}
}
